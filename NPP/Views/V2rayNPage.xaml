<Page
    x:Class="Netch.App.Views.V2rayNPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid x:Name="ClientSlot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          LayoutUpdated="ClientSlot_LayoutUpdated">
        <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="600" Margin="32" Spacing="16">
            <ProgressRing x:Name="StartupProgress" Width="32" Height="32" Visibility="Collapsed" />
            <TextBlock x:Name="ClientStatus" FontSize="16"
                       TextWrapping="Wrap" TextAlignment="Center" />
            <Button x:Name="StartClientButton" Content="启动代理线路" HorizontalAlignment="Center"
                    Visibility="Collapsed" Click="StartClientButton_Click" />
        </StackPanel>
    </Grid>
</Page>
