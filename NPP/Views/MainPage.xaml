<Page
    x:Class="Netch.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Netch.App.Models"
    NavigationCacheMode="Required"
    IsTabStop="True">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HomePageBackgroundBrush" Color="#F6F8FB" />
                    <SolidColorBrush x:Key="HomeSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HomeSoftBrush" Color="#EDF2F8" />
                    <SolidColorBrush x:Key="HomeTextBrush" Color="#172033" />
                    <SolidColorBrush x:Key="HomeMutedBrush" Color="#5F6D80" />
                    <SolidColorBrush x:Key="HomeLineBrush" Color="#DFE6EF" />
                    <SolidColorBrush x:Key="HomeAccentBrush" Color="#6556D9" />
                    <SolidColorBrush x:Key="HomeAccentStrongBrush" Color="#5546CC" />
                    <SolidColorBrush x:Key="HomeAccentSoftBrush" Color="#F0EEFC" />

                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#6556D9" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#5546CC" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#4B3DB9" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#6556D9" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#5546CC" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#4B3DB9" />

                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#5546CC" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#6556D9" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#4B3DB9" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="HomePageBackgroundBrush" Color="#11151C" />
                    <SolidColorBrush x:Key="HomeSurfaceBrush" Color="#191F28" />
                    <SolidColorBrush x:Key="HomeSoftBrush" Color="#212A36" />
                    <SolidColorBrush x:Key="HomeTextBrush" Color="#EDF3FB" />
                    <SolidColorBrush x:Key="HomeMutedBrush" Color="#A6B1C1" />
                    <SolidColorBrush x:Key="HomeLineBrush" Color="#2B3542" />
                    <SolidColorBrush x:Key="HomeAccentBrush" Color="#9A8FFF" />
                    <SolidColorBrush x:Key="HomeAccentStrongBrush" Color="#7264E7" />
                    <SolidColorBrush x:Key="HomeAccentSoftBrush" Color="#302D4A" />

                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#7264E7" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#8377EF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#6556D9" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#7264E7" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#8377EF" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#6556D9" />

                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#7264E7" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#8377EF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#6556D9" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Thickness x:Key="HomeFieldPadding">11,8,11,2</Thickness>
            <Thickness x:Key="HomeIconFieldPadding">35,8,10,2</Thickness>

            <Style x:Key="HomeCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource HomeMutedBrush}" />
            </Style>

            <Style x:Key="HomePanelTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource HomeTextBrush}" />
            </Style>

            <Style x:Key="HomeFieldStyle" TargetType="TextBox">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="{StaticResource HomeFieldPadding}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Foreground" Value="{ThemeResource HomeTextBrush}" />
                <Setter Property="Background" Value="{ThemeResource HomePageBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource HomeLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="HomeRowButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="60" />
                <Setter Property="MinHeight" Value="60" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="InteractionOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.45"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="InteractionOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.8"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RowRoot"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.5"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="RowRoot"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <Border x:Name="InteractionOverlay"
                                        Background="{ThemeResource HomeAccentSoftBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <ContentPresenter Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HomeIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Background" Value="{ThemeResource HomeSurfaceBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource HomeMutedBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource HomeLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="HomeTextButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="{ThemeResource HomeMutedBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="HomeActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="38" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="ActionRoot">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ActionOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.65"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ActionOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ActionRoot"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.45"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                <Border x:Name="ActionOverlay"
                                        Margin="1"
                                        Background="{ThemeResource HomeAccentSoftBrush}"
                                        CornerRadius="7"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  FontWeight="{TemplateBinding FontWeight}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="HomeSecondaryActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource HomeActionButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource HomeTextBrush}" />
                <Setter Property="Background" Value="{ThemeResource HomePageBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource HomeLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="HomePrimaryActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource HomeActionButtonStyle}">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{ThemeResource HomeAccentStrongBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource HomeAccentStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="HomeSegmentRadioStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource HomeMutedBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource HomeAccentBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource HomeSurfaceBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="SegmentRoot">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="InteractionOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.65"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="InteractionOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SegmentRoot"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.45"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectedSurface"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1"
                                                                 Duration="0" />
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SegmentContent"
                                                                               Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                                            Value="{ThemeResource HomeAccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="SelectedSurface"
                                        Background="{ThemeResource HomeAccentSoftBrush}"
                                        BorderBrush="{ThemeResource HomeAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <Border x:Name="InteractionOverlay"
                                        Margin="1"
                                        Background="{ThemeResource HomeAccentSoftBrush}"
                                        CornerRadius="6"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <ContentPresenter x:Name="SegmentContent"
                                                  Content="{TemplateBinding Content}"
                                                  Padding="{TemplateBinding Padding}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  FontWeight="{TemplateBinding FontWeight}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource HomePageBackgroundBrush}">
        <Grid x:Name="HomeContent"
              x:Load="{x:Bind ShouldLoadHomeContent, Mode=OneWay}"
              MaxWidth="1040"
              Padding="22,14,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ProxySettingsCard"
                Grid.Row="0"
                MinHeight="78"
                Padding="14,12"
                CornerRadius="10"
                Background="{ThemeResource HomeSurfaceBrush}"
                BorderBrush="{ThemeResource HomeLineBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="9">
                    <Border Width="32"
                            Height="32"
                            CornerRadius="8"
                            Background="{ThemeResource HomeAccentSoftBrush}">
                        <Viewbox Width="15" Height="15">
                            <Grid Width="24" Height="24">
                                <Path Data="M 12,2 L 20,5 V 11 C 20,16 16.5,20 12,22 C 7.5,20 4,16 4,11 V 5 Z"
                                      Stroke="{ThemeResource HomeAccentBrush}"
                                      StrokeThickness="1.8" />
                                <Path Data="M 8,11.5 L 10.8,14.2 L 16.5,8.5"
                                      Stroke="{ThemeResource HomeAccentBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="SOCKS5 本地代理" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="单端口流量入口" FontSize="12" Foreground="{ThemeResource HomeMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="地址" FontSize="12" Foreground="{ThemeResource HomeMutedBrush}" />
                     <TextBox x:Name="ProxyHostTextBox"
                              AutomationProperties.Name="代理地址"
                              Text="{x:Bind ViewModel.ProxyHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind ViewModel.IsHostEditable, Mode=OneWay}"
                             PlaceholderText="127.0.0.1"
                             Style="{StaticResource HomeFieldStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="端口" FontSize="12" Foreground="{ThemeResource HomeMutedBrush}" />
                    <TextBox x:Name="ProxyPortTextBox"
                             AutomationProperties.Name="代理端口"
                             InputScope="Number"
                             MaxLength="5"
                             Text="{x:Bind ViewModel.ProxyPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="10808"
                             Style="{StaticResource HomeFieldStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Spacing="3">
                    <TextBlock Text="地址"
                               FontSize="12"
                               Opacity="0"
                               IsHitTestVisible="False" />
                    <CheckBox AutomationProperties.Name="使用本机地址"
                              IsChecked="{x:Bind ViewModel.UseLocalhostOverride, Mode=TwoWay}"
                              Content="本机地址"
                              FontSize="13"
                              Height="36"
                              MinHeight="36"
                              Padding="8,0,0,0"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center">
                        <CheckBox.Resources>
                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#5546CC" />
                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#6556D9" />
                            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#4B3DB9" />
                        </CheckBox.Resources>
                    </CheckBox>
                </StackPanel>

                <Button Grid.Column="4"
                        Height="36"
                        MinHeight="36"
                        Padding="10,0"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="高级代理设置"
                        Content="高级"
                        Click="AdvancedSettings_Click"
                        Style="{StaticResource HomeSecondaryActionButtonStyle}" />

            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="AppSelectionCard"
                    Grid.Column="0"
                    MinHeight="0"
                    Padding="0"
                    CornerRadius="10"
                    Background="{ThemeResource HomeSurfaceBrush}"
                    BorderBrush="{ThemeResource HomeLineBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            MinHeight="63"
                            Padding="14,10"
                            BorderBrush="{ThemeResource HomeLineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="214" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="添加应用" Style="{StaticResource HomePanelTitleStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ApplicationSelectionStatusText, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource HomeCaptionStyle}" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="214"
                                    Height="42"
                                    Padding="3"
                                    CornerRadius="10"
                                    Background="{ThemeResource HomePageBackgroundBrush}"
                                    BorderBrush="{ThemeResource HomeLineBrush}"
                                    BorderThickness="1">
                                <Grid ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0"
                                                 AutomationProperties.Name="应用列表模式"
                                                 GroupName="AppSourceMode"
                                                 Style="{StaticResource HomeSegmentRadioStyle}"
                                                 IsChecked="{x:Bind ViewModel.UseAppListSource, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="7">
                                            <FontIcon Glyph="&#xE71D;" FontSize="14" />
                                            <TextBlock Text="应用列表" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Grid.Column="1"
                                                 AutomationProperties.Name="目录查找模式"
                                                 GroupName="AppSourceMode"
                                                 Style="{StaticResource HomeSegmentRadioStyle}"
                                                 IsChecked="{x:Bind ViewModel.UseDirectorySearchSource, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="7">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                            <TextBlock Text="目录查找" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          Padding="14,14,14,18"
                          Visibility="{x:Bind ViewModel.AppListSourceVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Height="38">
                            <TextBox Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="搜索应用"
                                     PlaceholderText="{x:Bind ViewModel.AppsSearchPlaceholder, Mode=OneWay}"
                                     Style="{StaticResource HomeFieldStyle}"
                                     Height="38"
                                     Padding="{StaticResource HomeIconFieldPadding}" />
                            <FontIcon Glyph="&#xE721;"
                                      Width="14"
                                      Height="14"
                                      Margin="11,0,0,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      FontSize="14"
                                      Foreground="{ThemeResource HomeMutedBrush}"
                                      IsHitTestVisible="False" />
                        </Grid>

                        <ListView Grid.Row="1"
                                  Margin="0,10,0,0"
                                  ItemsSource="{x:Bind ViewModel.FilteredApps}"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:InstalledApp">
                                         <Button Tag="{x:Bind}"
                                                AutomationProperties.Name="{x:Bind Name}"
                                                Style="{StaticResource HomeRowButtonStyle}"
                                                Background="{x:Bind RowBackground, Mode=OneWay}"
                                                BorderBrush="{x:Bind RowBorderBrush, Mode=OneWay}"
                                                Click="AppRow_Click">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Width="18"
                                                        Height="18"
                                                        CornerRadius="5"
                                                        Background="{x:Bind CheckBackground, Mode=OneWay}"
                                                        BorderBrush="{x:Bind CheckBorderBrush, Mode=OneWay}"
                                                        BorderThickness="1">
                                                    <FontIcon Glyph="&#xE73E;"
                                                              FontSize="12"
                                                              Foreground="White"
                                                              Visibility="{x:Bind CheckVisibility, Mode=OneWay}" />
                                                </Border>
                                                <Border Grid.Column="1"
                                                        Width="36"
                                                        Height="36"
                                                        CornerRadius="8"
                                                        Background="{x:Bind LogoBackground}">
                                                    <Grid>
                                                        <TextBlock Text="{x:Bind Initial}"
                                                                   FontSize="13"
                                                                   FontWeight="Medium"
                                                                   Foreground="{x:Bind LogoForeground}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{x:Bind LogoTextVisibility}" />
                                                        <FontIcon Glyph="&#xE724;"
                                                                  FontSize="13"
                                                                  Foreground="{x:Bind LogoForeground}"
                                                                  Visibility="{x:Bind TelegramIconVisibility}" />
                                                        <FontIcon Glyph="&#xE7B8;"
                                                                  FontSize="13"
                                                                  Foreground="{x:Bind LogoForeground}"
                                                                  Visibility="{x:Bind PackageIconVisibility}" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource HomeTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                     <TextBlock Text="{x:Bind InstallPath}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource HomeMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind InstallPath}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid Grid.Row="1"
                          Padding="14,14,14,18"
                          Visibility="{x:Bind ViewModel.DirectorySourceVisibility, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Height="38" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox Text="{x:Bind ViewModel.DirectoryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="目录路径"
                                         PlaceholderText="选择或粘贴目录路径"
                                          Style="{StaticResource HomeFieldStyle}"
                                          Height="38"
                                          Padding="{StaticResource HomeIconFieldPadding}" />
                                <FontIcon Glyph="&#xE8B7;"
                                          Width="14"
                                          Height="14"
                                          Margin="11,0,0,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          FontSize="14"
                                          Foreground="{ThemeResource HomeMutedBrush}"
                                          IsHitTestVisible="False" />
                            </Grid>
                            <Button Grid.Column="1"
                                    AutomationProperties.Name="浏览目录"
                                    Command="{x:Bind ViewModel.BrowseDirectoryCommand}"
                                    Style="{StaticResource HomeSecondaryActionButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="浏览" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ScanDirectoryButton"
                                    Grid.Column="2"
                                    AutomationProperties.Name="扫描目录"
                                    Command="{x:Bind ViewModel.ScanDirectoryCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanScanDirectory, Mode=OneWay}"
                                    Style="{StaticResource HomePrimaryActionButtonStyle}"
                                    Content="{x:Bind ViewModel.DirectoryScanButtonText, Mode=OneWay}" />
                        </Grid>

                        <Grid Grid.Row="1" Height="46" Margin="0,8,0,0">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.ScanSubdirectories, Mode=TwoWay}"
                                          MinWidth="0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          FontSize="13"
                                          OnContent="包含子目录"
                                          OffContent="包含子目录"
                                          AutomationProperties.Name="包含子目录">
                                <ToggleSwitch.Resources>
                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#6556D9" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#5546CC" />
                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#4B3DB9" />
                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#6556D9" />
                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#5546CC" />
                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#4B3DB9" />
                                </ToggleSwitch.Resources>
                            </ToggleSwitch>
                            <TextBlock Text="仅识别可执行程序"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource HomeCaptionStyle}" />
                            <Border Height="1"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource HomeLineBrush}" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <StackPanel Margin="16,28,16,24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.DirectoryEmptyStateVisibility, Mode=OneWay}">
                                <Border Width="46"
                                        Height="46"
                                        Margin="0,0,0,4"
                                        HorizontalAlignment="Center"
                                        CornerRadius="14"
                                        Background="{ThemeResource HomeAccentSoftBrush}">
                                    <FontIcon Glyph="&#xE8B7;"
                                              FontSize="20"
                                              Foreground="{ThemeResource HomeAccentBrush}" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.DirectoryEmptyTitle, Mode=OneWay}"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource HomeTextBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.DirectoryEmptyDescription, Mode=OneWay}"
                                           MaxWidth="320"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource HomeCaptionStyle}" />
                            </StackPanel>

                            <ListView ItemsSource="{x:Bind ViewModel.DirectoryProcesses}"
                                      SelectionMode="None"
                                      Padding="0"
                                      Margin="0,10,0,0"
                                      Visibility="{x:Bind ViewModel.DirectoryProcessListVisibility, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProcessEntry">
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  Click="DirectoryProcessCheckBox_Click"
                                                  Tag="{x:Bind}"
                                                  FontSize="13"
                                                  Content="{x:Bind FileName}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="ProxyRulesCard"
                    Grid.Column="1"
                    MinHeight="0"
                    Padding="14"
                    CornerRadius="10"
                    Background="{ThemeResource HomeSurfaceBrush}"
                    BorderBrush="{ThemeResource HomeLineBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="代理应用"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource HomePanelTitleStyle}" />
                        <Button Content="清空"
                                HorizontalAlignment="Right"
                                Style="{StaticResource HomeTextButtonStyle}"
                                Foreground="{ThemeResource HomeAccentBrush}"
                                Click="ClearSelection_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ProcessGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProcessGroup">
                                        <Border Margin="0,10,0,0"
                                                Padding="12"
                                                CornerRadius="9"
                                                Background="{ThemeResource HomeSoftBrush}">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" ColumnSpacing="7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="36"
                                                            Height="36"
                                                            CornerRadius="8"
                                                            Background="{x:Bind LogoBackground}">
                                                        <Grid>
                                                            <TextBlock Text="{x:Bind Initial}"
                                                                       FontSize="13"
                                                                       FontWeight="Medium"
                                                                       Foreground="{x:Bind LogoForeground}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{x:Bind LogoTextVisibility}" />
                                                            <FontIcon Glyph="&#xE724;"
                                                                      FontSize="13"
                                                                      Foreground="{x:Bind LogoForeground}"
                                                                      Visibility="{x:Bind TelegramIconVisibility}" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{x:Bind GroupName}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind ProcessCountText, Mode=OneWay}"
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource HomeMutedBrush}" />
                                                    </StackPanel>
                                                     <Button Grid.Column="2"
                                                            AutomationProperties.Name="添加进程"
                                                            Tag="{x:Bind}"
                                                            Style="{StaticResource HomeIconButtonStyle}"
                                                            Click="AddExeToGroup_Click"
                                                            ToolTipService.ToolTip="编辑">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                    </Button>
                                                     <Button Grid.Column="3"
                                                            AutomationProperties.Name="移除应用"
                                                            Tag="{x:Bind}"
                                                            Style="{StaticResource HomeIconButtonStyle}"
                                                            Click="RemoveGroup_Click"
                                                            ToolTipService.ToolTip="删除">
                                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                                <Border Grid.Row="1"
                                                        Padding="0,8,0,0"
                                                        BorderBrush="{ThemeResource HomeLineBrush}"
                                                        BorderThickness="0,1,0,0">
                                                     <TextBlock Text="{x:Bind DisplayText, Mode=OneWay}"
                                                               FontSize="12"
                                                               LineHeight="18"
                                                               Foreground="{ThemeResource HomeMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap"
                                                               MaxLines="2"
                                                               ToolTipService.ToolTip="{x:Bind DisplayText, Mode=OneWay}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="ConfigurationLockOverlay"
                Grid.Row="1"
                Grid.RowSpan="2"
                Canvas.ZIndex="20"
                Background="#01FFFFFF"
                Visibility="Collapsed" />
        </Grid>

        <ContentDialog x:Name="AdvancedProxyDialog"
                       PrimaryButtonText="保存"
                       SecondaryButtonText="恢复默认"
                       CloseButtonText="取消"
                       DefaultButton="Primary"
                       PrimaryButtonClick="AdvancedProxyDialog_PrimaryButtonClick"
                       SecondaryButtonClick="AdvancedProxyDialog_SecondaryButtonClick">
            <ContentDialog.Title>
                <TextBlock Text="高级代理设置"
                           FontSize="17"
                           FontWeight="SemiBold" />
            </ContentDialog.Title>
            <ScrollViewer MaxHeight="380"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AdvancedProxyDialogContent"
                            Width="440"
                            Spacing="10"
                            Background="Transparent"
                            Tapped="AdvancedProxyDialogContent_Tapped">
                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Message="停止代理后可修改；保存后在下次启动时生效。" />

                    <InfoBar x:Name="AdvancedProxyErrorBar"
                             IsOpen="False"
                             IsClosable="False"
                             Severity="Error" />

                    <Grid MinHeight="44" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="绕过局域网" FontWeight="SemiBold" />
                            <TextBlock Text="保持路由器、NAS、打印机及常见私网地址直连。"
                                       FontSize="12"
                                       Foreground="{ThemeResource HomeMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AdvancedBypassLanToggle"
                                      Grid.Column="1"
                                      OnContent="开"
                                      OffContent="关" />
                    </Grid>

                    <Border BorderBrush="{ThemeResource HomeLineBrush}" BorderThickness="0,1,0,0" />

                    <Grid MinHeight="44" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="代理 UDP" FontWeight="SemiBold" />
                            <TextBlock Text="游戏、语音与 QUIC 需要；关闭后 UDP、DNS 直连。"
                                       FontSize="12"
                                       Foreground="{ThemeResource HomeMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AdvancedUdpToggle"
                                      Grid.Column="1"
                                      OnContent="开"
                                      OffContent="关"
                                      Toggled="AdvancedUdpToggle_Toggled" />
                    </Grid>

                    <StackPanel x:Name="AdvancedDnsSection" Spacing="10">
                        <Border BorderBrush="{ThemeResource HomeLineBrush}" BorderThickness="0,1,0,0" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="DNS 服务器"
                                       FontWeight="SemiBold" />
                            <TextBox x:Name="AdvancedDnsHostTextBox"
                                     AutomationProperties.Name="DNS 服务器"
                                     PlaceholderText="1.1.1.1:53"
                                     Style="{StaticResource HomeFieldStyle}"
                                     TextChanged="AdvancedDnsHostTextBox_TextChanged" />
                            <TextBlock Text="仅支持 IP 端点；IPv6 示例：[2606:4700:4700::1111]:53。"
                                       FontSize="12"
                                       Foreground="{ThemeResource HomeMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <Border BorderBrush="{ThemeResource HomeLineBrush}" BorderThickness="0,1,0,0" />

                    <Grid MinHeight="44" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="代理全部子进程" FontWeight="SemiBold" />
                            <TextBlock Text="同时代理所选程序启动的所有层级子进程。"
                                       FontSize="12"
                                       Foreground="{ThemeResource HomeMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AdvancedChildProcessToggle"
                                      Grid.Column="1"
                                      OnContent="开"
                                      OffContent="关" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <Grid Visibility="{x:Bind ViewModel.HomeLoadingVisibility, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing Width="30"
                              Height="30"
                              IsActive="True"
                              Foreground="{ThemeResource HomeAccentBrush}" />
                <TextBlock Text="正在加载应用列表…"
                           FontSize="13"
                           Foreground="{ThemeResource HomeMutedBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Visibility="{x:Bind ViewModel.HomeErrorVisibility, Mode=OneWay}">
            <StackPanel MaxWidth="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <Border Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        CornerRadius="12"
                        Background="{ThemeResource HomeAccentSoftBrush}">
                    <FontIcon Glyph="&#xEA39;"
                              FontSize="18"
                              Foreground="{ThemeResource HomeAccentBrush}" />
                </Border>
                <TextBlock Text="首页加载失败"
                           HorizontalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource HomeTextBrush}" />
                <TextBlock Text="{x:Bind ViewModel.HomeLoadError, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{ThemeResource HomeMutedBrush}" />
                <Button Content="重新加载"
                        Command="{x:Bind ViewModel.RetryHomeLoadCommand}"
                        HorizontalAlignment="Center"
                        Padding="16,7"
                        CornerRadius="8" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
