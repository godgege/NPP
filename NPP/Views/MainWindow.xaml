<Window
    x:Class="Netch.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F6F8FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#DFE6EF"
                BorderThickness="0,0,0,1"
                Loaded="AppTitleBar_Loaded"
                SizeChanged="AppTitleBar_SizeChanged">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="14,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Border Width="26" Height="26" CornerRadius="8">
                        <Image Width="26" Height="26" Stretch="Uniform">
                            <Image.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/NPP-small.svg" />
                            </Image.Source>
                        </Image>
                    </Border>
                    <TextBlock Text="NPP"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" Orientation="Horizontal">
                    <Button x:Name="HomeNavButton"
                            Content="应用分流"
                            Tag="MainPage"
                            Height="48"
                            MinWidth="0"
                            Padding="14,0"
                            FontSize="13"
                            Foreground="#172033"
                            Background="Transparent"
                            BorderBrush="#6556D9"
                            BorderThickness="0,0,0,2"
                            CornerRadius="0"
                            Click="NavButton_Click" />
                    <Button x:Name="V2rayNNavButton"
                            Content="代理节点"
                            Tag="V2rayNPage"
                            Height="48"
                            MinWidth="0"
                            Padding="14,0"
                            FontSize="13"
                            Foreground="#748094"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            Click="NavButton_Click" />
                    <Button x:Name="LogNavButton"
                            Content="日志"
                            Tag="LogPage"
                            Height="48"
                            MinWidth="0"
                            Padding="14,0"
                            FontSize="13"
                            Foreground="#748094"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            Click="NavButton_Click" />
                    <Button x:Name="SettingsNavButton"
                            Content="设置"
                            Tag="SettingsPage"
                            Height="48"
                            MinWidth="0"
                            Padding="14,0"
                            FontSize="13"
                            Foreground="#748094"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            Click="NavButton_Click" />
                </StackPanel>

                <Border x:Name="RightInsetSpace" Grid.Column="3" Width="138" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#F6F8FB">
            <Frame x:Name="ContentFrame"
                   CacheSize="4"
                   Background="#F6F8FB" />

            <Grid x:Name="PageLoadingOverlay"
                  Canvas.ZIndex="20"
                  Background="#F6F8FB"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressRing Width="28"
                                  Height="28"
                                  IsActive="True"
                                  Foreground="#6556D9" />
                    <TextBlock x:Name="PageLoadingText"
                               Text="正在打开页面…"
                               FontSize="13"
                               Foreground="#5F6D80"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Window>
