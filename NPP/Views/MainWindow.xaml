<Window
    x:Class="Netch.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F6F8FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#DFE6EF"
                BorderThickness="0,0,0,1"
                Loaded="AppTitleBar_Loaded"
                SizeChanged="AppTitleBar_SizeChanged">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="14,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Border Width="26" Height="26" CornerRadius="8">
                        <Image Width="26" Height="26" Stretch="Uniform">
                            <Image.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/NPP-small.svg" />
                            </Image.Source>
                        </Image>
                    </Border>
                    <TextBlock Text="NPP"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" Orientation="Horizontal">
                    <Button x:Name="HomeNavButton"
                            Content="首页"
                            Tag="MainPage"
                            Height="48"
                            MinWidth="0"
                            Padding="14,0"
                            FontSize="13"
                            Foreground="#172033"
                            Background="Transparent"
                            BorderBrush="#6556D9"
                            BorderThickness="0,0,0,2"
                            CornerRadius="0"
                            Click="NavButton_Click" />
                    <Button x:Name="LogNavButton"
                            Content="日志"
                            Tag="LogPage"
                            Height="48"
                            MinWidth="0"
                            Padding="14,0"
                            FontSize="13"
                            Foreground="#748094"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            Click="NavButton_Click" />
                    <Button x:Name="SettingsNavButton"
                            Content="设置"
                            Tag="SettingsPage"
                            Height="48"
                            MinWidth="0"
                            Padding="14,0"
                            FontSize="13"
                            Foreground="#748094"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            Click="NavButton_Click" />
                </StackPanel>

                <Grid Grid.Column="2" />

                <Border x:Name="TitleBarProxyStatus"
                        Grid.Column="3"
                        Height="32"
                        Margin="8,0,8,0"
                        Padding="11,0"
                        CornerRadius="16"
                        Background="#F1F4F8"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="代理状态">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse x:Name="TitleBarStatusDot" Width="7" Height="7" Fill="#8B97A8" />
                        <TextBlock x:Name="TitleBarStatusText"
                                   Text="未运行"
                                   FontSize="12"
                                   Foreground="#5E6B7E"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button x:Name="TitleBarStartStopButton"
                        Grid.Column="4"
                        Height="34"
                        MinWidth="96"
                        Margin="0,0,10,0"
                        Padding="16,0"
                        CornerRadius="8"
                        Background="#5546CC"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Content="启动代理"
                        VerticalContentAlignment="Center"
                        Click="TitleBarStartStopButton_Click" />

                <Border x:Name="RightInsetSpace" Grid.Column="5" Width="138" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#F6F8FB">
            <Frame x:Name="ContentFrame"
                   CacheSize="3"
                   Background="#F6F8FB" />

            <Grid x:Name="PageLoadingOverlay"
                  Canvas.ZIndex="20"
                  Background="#F6F8FB"
                  Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressRing Width="28"
                                  Height="28"
                                  IsActive="True"
                                  Foreground="#6556D9" />
                    <TextBlock x:Name="PageLoadingText"
                               Text="正在打开页面…"
                               FontSize="13"
                               Foreground="#5F6D80"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Window>
