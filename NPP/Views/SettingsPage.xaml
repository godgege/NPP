<Page
    x:Class="Netch.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Loaded="SettingsPage_Loaded"
    SizeChanged="SettingsPage_SizeChanged">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SettingsPageBackgroundBrush" Color="#F6F8FB" />
                    <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SettingsTextBrush" Color="#172033" />
                    <SolidColorBrush x:Key="SettingsMutedBrush" Color="#5F6D80" />
                    <SolidColorBrush x:Key="SettingsLineBrush" Color="#DFE6EF" />
                    <SolidColorBrush x:Key="SettingsAccentBrush" Color="#6556D9" />
                    <SolidColorBrush x:Key="SettingsAccentStrongBrush" Color="#5546CC" />
                    <SolidColorBrush x:Key="SettingsAccentSoftBrush" Color="#F0EEFC" />

                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#6556D9" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#5546CC" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#4B3DB9" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#6556D9" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#5546CC" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#4B3DB9" />

                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#5546CC" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#6556D9" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#4B3DB9" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SettingsPageBackgroundBrush" Color="#11151C" />
                    <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#191F28" />
                    <SolidColorBrush x:Key="SettingsTextBrush" Color="#EDF3FB" />
                    <SolidColorBrush x:Key="SettingsMutedBrush" Color="#A6B1C1" />
                    <SolidColorBrush x:Key="SettingsLineBrush" Color="#2B3542" />
                    <SolidColorBrush x:Key="SettingsAccentBrush" Color="#9A8FFF" />
                    <SolidColorBrush x:Key="SettingsAccentStrongBrush" Color="#7264E7" />
                    <SolidColorBrush x:Key="SettingsAccentSoftBrush" Color="#302D4A" />

                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#7264E7" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#8377EF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#6556D9" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#7264E7" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#8377EF" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#6556D9" />

                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#7264E7" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#8377EF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#6556D9" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SettingsSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SettingsLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="SettingsCardHeaderStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="54" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="BorderBrush" Value="{ThemeResource SettingsLineBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>

            <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsOptionRowStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="BorderBrush" Value="{ThemeResource SettingsLineBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>

            <Style x:Key="SettingsOptionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource SettingsMutedBrush}" />
            </Style>

            <Style x:Key="SettingsToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="Width" Value="52" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="OnContent" Value="{x:Null}" />
                <Setter Property="OffContent" Value="{x:Null}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="SettingsPrimaryActionButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="82" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="{ThemeResource AccentButtonBackground}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="SettingsSecondaryActionButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="54" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource SettingsPageBackgroundBrush}">
        <ScrollViewer x:Name="SettingsScroll"
                      Padding="22,14,22,18"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="SettingsLayout"
                  MaxWidth="1040"
                  HorizontalAlignment="Stretch"
                  ColumnSpacing="12"
                  RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="StartupCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SettingsCardHeaderStyle}">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="9">
                                <Border Width="30"
                                        Height="30"
                                        CornerRadius="8"
                                        Background="{ThemeResource SettingsAccentSoftBrush}">
                                    <FontIcon Glyph="&#xE7E8;"
                                              FontSize="14"
                                              Foreground="{ThemeResource SettingsAccentBrush}" />
                                </Border>
                                <TextBlock Text="启动与退出"
                                           Style="{StaticResource SettingsCardTitleStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SettingsOptionRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="关闭窗口时退出"
                                           Style="{StaticResource SettingsOptionLabelStyle}" />
                                <ToggleSwitch Grid.Column="1"
                                              AutomationProperties.Name="关闭窗口时退出"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              IsOn="{x:Bind ViewModel.ExitWhenClosed, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource SettingsOptionRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="退出时停止代理"
                                           Style="{StaticResource SettingsOptionLabelStyle}" />
                                <ToggleSwitch Grid.Column="1"
                                              AutomationProperties.Name="退出时停止代理"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              IsOn="{x:Bind ViewModel.StopWhenExited, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource SettingsOptionRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="打开后启动代理"
                                           Style="{StaticResource SettingsOptionLabelStyle}" />
                                <ToggleSwitch Grid.Column="1"
                                              AutomationProperties.Name="打开后启动代理"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              IsOn="{x:Bind ViewModel.StartWhenOpened, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource SettingsOptionRowStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="启动后最小化"
                                           Style="{StaticResource SettingsOptionLabelStyle}" />
                                <ToggleSwitch Grid.Column="1"
                                              AutomationProperties.Name="启动后最小化"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              IsOn="{x:Bind ViewModel.MinimizeWhenStarted, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="5"
                                Style="{StaticResource SettingsOptionRowStyle}"
                                BorderThickness="0">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="开机自启动"
                                           Style="{StaticResource SettingsOptionLabelStyle}" />
                                <ToggleSwitch Grid.Column="1"
                                              AutomationProperties.Name="开机自启动"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel x:Name="SecondaryColumn"
                            Grid.Row="0"
                            Grid.Column="1"
                            Spacing="12">
                    <Border x:Name="UpdatesCard"
                            Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource SettingsCardHeaderStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Spacing="9">
                                        <Border Width="30"
                                                Height="30"
                                                CornerRadius="8"
                                                Background="{ThemeResource SettingsAccentSoftBrush}">
                                            <FontIcon Glyph="&#xE72C;"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource SettingsAccentBrush}" />
                                        </Border>
                                        <TextBlock Text="更新"
                                                   Style="{StaticResource SettingsCardTitleStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.UpdateService.CurrentVersionText, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SettingsCaptionStyle}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource SettingsOptionRowStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="打开时检查更新"
                                               Style="{StaticResource SettingsOptionLabelStyle}" />
                                    <ToggleSwitch Grid.Column="1"
                                                  AutomationProperties.Name="打开时检查更新"
                                                  Style="{StaticResource SettingsToggleStyle}"
                                                  IsOn="{x:Bind ViewModel.CheckUpdateWhenOpened, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Style="{StaticResource SettingsOptionRowStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="检查测试版更新"
                                               Style="{StaticResource SettingsOptionLabelStyle}" />
                                    <ToggleSwitch Grid.Column="1"
                                                  AutomationProperties.Name="检查测试版更新"
                                                  Style="{StaticResource SettingsToggleStyle}"
                                                  IsOn="{x:Bind ViewModel.CheckBetaUpdate, Mode=TwoWay}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="3"
                                    MinHeight="72"
                                    Padding="14,10"
                                    Style="{StaticResource SettingsOptionRowStyle}"
                                    BorderThickness="0">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="7">
                                        <TextBlock Text="{x:Bind ViewModel.UpdateService.StatusText, Mode=OneWay}"
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Style="{StaticResource SettingsCaptionStyle}" />
                                        <ProgressBar Height="4"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{x:Bind ViewModel.UpdateService.DownloadProgress, Mode=OneWay}"
                                                     Visibility="{x:Bind ViewModel.UpdateService.ProgressVisibility, Mode=OneWay}"
                                                     AutomationProperties.Name="更新下载进度" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Spacing="8">
                                        <Button Content="{x:Bind ViewModel.UpdateService.ActionText, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.RunUpdateActionCommand}"
                                                IsEnabled="{x:Bind ViewModel.UpdateService.IsActionEnabled, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.UpdateService.ActionVisibility, Mode=OneWay}"
                                                AutomationProperties.Name="更新操作"
                                                Style="{StaticResource SettingsPrimaryActionButtonStyle}" />
                                        <Button Content="取消"
                                                Command="{x:Bind ViewModel.CancelUpdateCommand}"
                                                Visibility="{x:Bind ViewModel.UpdateService.CancelVisibility, Mode=OneWay}"
                                                AutomationProperties.Name="取消下载更新"
                                                Style="{StaticResource SettingsSecondaryActionButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="AboutCard"
                            Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="90" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource SettingsCardHeaderStyle}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="9">
                                    <Border Width="30"
                                            Height="30"
                                            CornerRadius="8"
                                            Background="{ThemeResource SettingsAccentSoftBrush}">
                                        <FontIcon Glyph="&#xE946;"
                                                  FontSize="14"
                                                  Foreground="{ThemeResource SettingsAccentBrush}" />
                                    </Border>
                                    <TextBlock Text="关于"
                                               Style="{StaticResource SettingsCardTitleStyle}" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1"
                                  Padding="14,0"
                                  ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38"
                                        Height="38"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">
                                    <Image Width="38" Height="38" Stretch="Uniform">
                                        <Image.Source>
                                            <SvgImageSource UriSource="ms-appx:///Assets/NPP.svg" />
                                        </Image.Source>
                                    </Image>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Text="NPP"
                                               Style="{StaticResource SettingsCardTitleStyle}" />
                                    <TextBlock Text="GPLv3 · 进程级流量代理"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource SettingsCaptionStyle}" />
                                </StackPanel>
                                <HyperlinkButton Grid.Column="2"
                                                 Content="GitHub"
                                                 NavigateUri="https://github.com/godgege/netch"
                                                 MinWidth="0"
                                                 MinHeight="32"
                                                 Padding="10,0"
                                                 CornerRadius="7"
                                                 VerticalAlignment="Center"
                                                 Foreground="{ThemeResource SettingsAccentBrush}" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
